{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carelake/prescriptions/1",
  "title": "prescriptions",
  "x-resource": "MedicationRequest",
  "x-key": "rxid",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["rxid", "pid", "status", "intent", "system", "code", "written_at"],
  "properties": {
    "rxid":           {"type": ["string", "null"], "x-phi": "unique-id", "x-scrub": "hash"},
    "pid":            {"type": ["string", "null"], "x-phi": "unique-id", "x-scrub": "hash"},
    "eid":            {"type": ["string", "null"], "x-phi": "unique-id", "x-scrub": "hash"},
    "status":         {"type": ["string", "null"], "enum": ["active", "on-hold", "cancelled", "completed", "entered-in-error", "stopped", "draft", "unknown", null]},
    "intent":         {"type": ["string", "null"]},
    "category":       {"type": ["string", "null"]},
    "system":         {"type": ["string", "null"]},
    "code":           {"type": ["string", "null"]},
    "label":          {"type": ["string", "null"], "x-free-text": true},
    "written_at":     {"type": ["string", "null"], "format": "date-time", "x-phi": "date", "x-scrub": "offset"},
    "prescriber_npi": {"type": ["string", "null"]},
    "prescriber":     {"type": ["string", "null"], "x-scrub": "drop"},
    "for_cid":        {"type": ["string", "null"], "x-phi": "unique-id", "x-scrub": "hash"}
  },
  "x-rules": [
    {"check": "past", "field": "written_at"}
  ]
}
