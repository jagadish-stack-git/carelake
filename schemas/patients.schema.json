{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carelake/patients/1",
  "title": "patients",
  "x-resource": "Patient",
  "x-key": "pid",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["pid", "sex", "dob"],
  "properties": {
    "pid":            {"type": ["string", "null"], "x-phi": "unique-id",  "x-scrub": "hash"},
    "mrn":            {"type": ["string", "null"], "x-phi": "mrn",        "x-scrub": "drop"},
    "ssn":            {"type": ["string", "null"], "x-phi": "ssn",        "x-scrub": "drop", "pattern": "^[0-9]{3}-[0-9]{2}-[0-9]{4}$"},
    "license_no":     {"type": ["string", "null"], "x-phi": "licence",    "x-scrub": "drop"},
    "passport_no":    {"type": ["string", "null"], "x-phi": "licence",    "x-scrub": "drop"},
    "surname":        {"type": ["string", "null"], "x-phi": "name",       "x-scrub": "drop"},
    "forenames":      {"type": ["string", "null"], "x-phi": "name",       "x-scrub": "drop"},
    "prefix":         {"type": ["string", "null"], "x-phi": "name",       "x-scrub": "drop"},
    "maiden_surname": {"type": ["string", "null"], "x-phi": "name",       "x-scrub": "drop"},
    "mother_maiden":  {"type": ["string", "null"], "x-phi": "name",       "x-scrub": "drop"},
    "tel":            {"type": ["string", "null"], "x-phi": "phone",      "x-scrub": "drop"},
    "fax":            {"type": ["string", "null"], "x-phi": "fax",        "x-scrub": "drop"},
    "mail":           {"type": ["string", "null"], "x-phi": "email",      "x-scrub": "drop"},
    "photo":          {"type": ["string", "null"], "x-phi": "photo",      "x-scrub": "drop"},
    "sex":            {"type": ["string", "null"], "enum": ["male", "female", "other", "unknown", null]},
    "dob":            {"type": ["string", "null"], "format": "date",      "x-phi": "date", "x-scrub": "dob_year"},
    "died_at":        {"type": ["string", "null"], "format": "date-time", "x-phi": "date", "x-scrub": "offset"},
    "marital":        {"type": ["string", "null"]},
    "race":           {"type": ["string", "null"]},
    "ethnicity":      {"type": ["string", "null"]},
    "sex_at_birth":   {"type": ["string", "null"], "enum": ["M", "F", null]},
    "multiple_birth": {"type": ["boolean", "null"]},
    "lang":           {"type": ["string", "null"]},
    "street":         {"type": ["string", "null"], "x-phi": "geo",        "x-scrub": "drop"},
    "town":           {"type": ["string", "null"], "x-phi": "geo",        "x-scrub": "drop"},
    "region":         {"type": ["string", "null"]},
    "zip":            {"type": ["string", "null"], "x-phi": "geo",        "x-scrub": "zip3"},
    "country":        {"type": ["string", "null"]},
    "lat":            {"type": ["number", "null"], "x-phi": "geo",        "x-scrub": "drop", "minimum": -90, "maximum": 90},
    "lng":            {"type": ["number", "null"], "x-phi": "geo",        "x-scrub": "drop", "minimum": -180, "maximum": 180},
    "born_town":      {"type": ["string", "null"], "x-phi": "geo",        "x-scrub": "drop"},
    "born_region":    {"type": ["string", "null"]},
    "narrative":      {"type": ["string", "null"], "x-phi": "unique-id",  "x-scrub": "drop"}
  },
  "x-rules": [
    {"check": "past", "field": "dob"},
    {"check": "ordered", "earlier": "dob", "later": "died_at"}
  ]
}
